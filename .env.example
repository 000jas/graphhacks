# FalkorDB Cloud Configuration
FALKORDB_HOST=your-falkordb-host.cloud
FALKORDB_PORT=54637
FALKORDB_USERNAME=falkordb
FALKORDB_PASSWORD=your-falkordb-password
FALKORDB_SSL=false
GRAPHOS_GRAPH_NAME=graphos_dev

# Active LLM Provider: nvidia, openai, anthropic, ollama, or mock
LLM_PROVIDER=nvidia

# Model Name / Identifier (NVIDIA default: openai/gpt-oss-20b)
LLM_MODEL=openai/gpt-oss-20b

# ---------------- NVIDIA (Default) ----------------
LLM_API_BASE=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your-nvidia-api-key

# ---------------- OPENAI ----------------
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------- ANTHROPIC CLAUDE ----------------
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------- OLLAMA ----------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---------------- MCP CONNECTION ----------------
# Supported: stdio or streamable_http
MCP_TRANSPORT=stdio

# Used for Streamable HTTP transport
MCP_SERVER_URL=http://localhost:8000/sse
MCP_AUTH_TOKEN=

# Used for stdio transport
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=mcp_server/server.py
MCP_SERVER_CWD=.

# ---------------- AGENT CONFIGURATION ----------------
AGENT_NAME=GraphOS Investigator
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=20
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_REQUEST_TIMEOUT_SECONDS=180
AGENT_MAX_RESULT_CHARS=12000

# ---------------- SAFETY & GUARDRAILS ----------------
AGENT_READ_ONLY=true
AGENT_ALLOW_ACTION_EXECUTION=false

# ---------------- LOGGING ----------------
LOG_LEVEL=INFO
LOG_TOOL_CALLS=true
LOG_REDACT_SECRETS=true
